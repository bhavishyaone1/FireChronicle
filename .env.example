# ==============================================================================
# FireChronicle — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env
#
# NEVER commit your actual .env file or expose your FIRMS_MAP_KEY.
# ==============================================================================

# NASA FIRMS API Map Key
# Obtain your free map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Data Storage Paths (relative to repository root or absolute)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample
DUCKDB_PATH=data/firechronicle.duckdb
